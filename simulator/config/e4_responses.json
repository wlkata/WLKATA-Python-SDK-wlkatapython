{
  "_description": "Response configuration for E4 simulator (4-axis)",
  "_version": "1.0.0",
  "_model": "e4",
  "_extends": "base",
  
  "commands": [
    {
      "_comment": "E4 uses 4-axis status query handler",
      "name": "status_query",
      "handler": "handle_e4_status_query"
    },
    {
      "_comment": "E4 uses 4-axis angle movement",
      "name": "angle_movement",
      "handler": "handle_e4_angle_movement"
    },
    {
      "_comment": "E4 uses 4-axis cartesian movement",
      "name": "cartesian_movement",
      "handler": "handle_e4_cartesian_movement"
    },
    {
      "_comment": "E4 uses 4-axis homing",
      "name": "homing",
      "handler": "handle_e4_homing"
    },
    {
      "name": "homing_default",
      "handler": "handle_e4_homing"
    },
    {
      "_comment": "E4 does not support expand axis - disabled",
      "name": "expand_axis",
      "pattern": "^G9[01]G0[01]D.*",
      "enabled": false,
      "description": "Not supported on E4"
    }
  ],
  
  "custom_commands": []
}
